{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus[1m]",
  "outputStyle": "Concise",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "CLAUDE_CODE_STOP_HOOK_BLOCK_CAP": "20"
  },
  "vim": true,
  "attribution": {
    "commit": "Co-Authored-By: Claude <noreply@anthropic.com>",
    "pr": "🤖 Generated with Claude Code",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo test:*)",
      "Bash(cat:*)",
      "Bash(codex exec -s read-only:*)",
      "Bash(docker compose:*)",
      "Bash(find:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git push:*)",
      "Bash(git show:*)",
      "Bash(git status)",
      "Bash(go build:*)",
      "Bash(go fmt:*)",
      "Bash(go mod:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(golangci-lint:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(markdownlint:*)",
      "Bash(npm run format:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run test:*)",
      "Bash(make test:*)",
      "Bash(prettier:*)",
      "Bash(rg:*)",
      "Bash(shellcheck:*)",
      "Bash(shfmt:*)",
      "Bash(tail:*)",
      "Bash(yarn format:*)",
      "Bash(yarn lint:*)",
      "Bash(yarn test:*)",
      "Bash(aws acm describe-*:*)",
      "Bash(aws acm get-*:*)",
      "Bash(aws acm list-*:*)",
      "Bash(aws apigatewayv2 get-*:*)",
      "Bash(aws chatbot describe-*:*)",
      "Bash(aws chatbot get-*:*)",
      "Bash(aws chatbot list-*:*)",
      "Bash(aws codebuild batch-get-*:*)",
      "Bash(aws codebuild list-*:*)",
      "Bash(aws dynamodb describe-*:*)",
      "Bash(aws dynamodb get-*:*)",
      "Bash(aws dynamodb list-*:*)",
      "Bash(aws dynamodb scan:*)",
      "Bash(aws ec2 describe-*:*)",
      "Bash(aws ecr describe-*:*)",
      "Bash(aws ecr list-*:*)",
      "Bash(aws ecs describe-*:*)",
      "Bash(aws ecs list-*:*)",
      "Bash(aws elbv2 describe-*:*)",
      "Bash(aws events describe-*:*)",
      "Bash(aws events list-*:*)",
      "Bash(aws iam get-*:*)",
      "Bash(aws iam list-*:*)",
      "Bash(aws lambda get-*:*)",
      "Bash(aws lambda list-*:*)",
      "Bash(aws logs describe-*:*)",
      "Bash(aws logs filter-*:*)",
      "Bash(aws logs get-*:*)",
      "Bash(aws rds describe-*:*)",
      "Bash(aws route53 get-*:*)",
      "Bash(aws route53 list-*:*)",
      "Bash(aws s3 ls:*)",
      "Bash(aws s3api get-*:*)",
      "Bash(aws s3api head-*:*)",
      "Bash(aws s3api list-*:*)",
      "Bash(aws scheduler get-*:*)",
      "Bash(aws scheduler list-*:*)",
      "Bash(aws secretsmanager describe-*:*)",
      "Bash(aws secretsmanager get-*:*)",
      "Bash(aws secretsmanager list-*:*)",
      "Bash(aws sns get-*:*)",
      "Bash(aws sns list-*:*)",
      "Bash(aws sqs get-*:*)",
      "Bash(aws sqs list-*:*)",
      "Bash(aws sqs receive-*:*)",
      "Bash(aws ssm describe-*:*)",
      "Bash(aws ssm get-*:*)",
      "Bash(aws ssm list-*:*)",
      "Bash(aws sts get-caller-identity:*)",
      "Bash(aws timestream-influxdb get-*:*)",
      "Bash(aws timestream-influxdb list-*:*)",
      "Glob",
      "Grep",
      "LS",
      "Read",
      "WebFetch(domain:doc.rust-lang.org)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:fluxcd.io)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "mcp__context7__query-docs",
      "mcp__context7__resolve-library-id"
    ],
    "deny": [
      "Read(~/.zshrc.local)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "( [ -n \"${HERDR_PANE_ID:-}\" ] && herdr pane report-agent \"$HERDR_PANE_ID\" --source claude-hooks --agent claude --state working ) >/dev/null 2>&1; true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "( [ -n \"${HERDR_PANE_ID:-}\" ] && herdr pane report-agent \"$HERDR_PANE_ID\" --source claude-hooks --agent claude --state working ) >/dev/null 2>&1; true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "( [ -n \"${HERDR_PANE_ID:-}\" ] && herdr pane report-agent \"$HERDR_PANE_ID\" --source claude-hooks --agent claude --state working ) >/dev/null 2>&1; true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "( [ -n \"${HERDR_PANE_ID:-}\" ] && herdr pane report-agent \"$HERDR_PANE_ID\" --source claude-hooks --agent claude --state blocked ) >/dev/null 2>&1; true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "( [ -n \"${HERDR_PANE_ID:-}\" ] && herdr pane report-agent \"$HERDR_PANE_ID\" --source claude-hooks --agent claude --state idle ) >/dev/null 2>&1; true"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "( [ -n \"${HERDR_PANE_ID:-}\" ] && herdr pane report-agent \"$HERDR_PANE_ID\" --source claude-hooks --agent claude --state blocked ) >/dev/null 2>&1; true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "( [ -n \"${HERDR_PANE_ID:-}\" ] && herdr pane release-agent \"$HERDR_PANE_ID\" --source claude-hooks --agent claude ) >/dev/null 2>&1; true"
          }
        ]
      }
    ]
  },
  "language": "Japanese",
  "effortLevel": "high",
  "remoteControlAtStartup": true,
  "voiceEnabled": true,
  "agentPushNotifEnabled": true,
  "extraKnownMarketplaces": {
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      }
    }
  },
  "enabledPlugins": {
    "slack@claude-plugins-official": true,
    "eli5@claude-community": true
  },
  "statusLine": {
    "type": "command",
    "command": "starship statusline claude-code"
  },
  "theme": "dark-ansi"
}
