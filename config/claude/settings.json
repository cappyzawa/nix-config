{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus[1m]",
  "outputStyle": "Concise",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "CLAUDE_CODE_STOP_HOOK_BLOCK_CAP": "20"
  },
  "vim": true,
  "attribution": {
    "commit": "Co-Authored-By: Claude <noreply@anthropic.com>",
    "pr": "🤖 Generated with Claude Code",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo test:*)",
      "Bash(cat:*)",
      "Bash(codex exec -s read-only:*)",
      "Bash(docker compose:*)",
      "Bash(find:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git push:*)",
      "Bash(git show:*)",
      "Bash(git status)",
      "Bash(go build:*)",
      "Bash(go fmt:*)",
      "Bash(go mod:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(golangci-lint:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(markdownlint:*)",
      "Bash(npm run format:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run test:*)",
      "Bash(make test:*)",
      "Bash(prettier:*)",
      "Bash(rg:*)",
      "Bash(shellcheck:*)",
      "Bash(shfmt:*)",
      "Bash(tail:*)",
      "Bash(yarn format:*)",
      "Bash(yarn lint:*)",
      "Bash(yarn test:*)",
      "Bash(aws acm describe-*:*)",
      "Bash(aws acm get-*:*)",
      "Bash(aws acm list-*:*)",
      "Bash(aws apigatewayv2 get-*:*)",
      "Bash(aws chatbot describe-*:*)",
      "Bash(aws chatbot get-*:*)",
      "Bash(aws chatbot list-*:*)",
      "Bash(aws codebuild batch-get-*:*)",
      "Bash(aws codebuild list-*:*)",
      "Bash(aws dynamodb describe-*:*)",
      "Bash(aws dynamodb get-*:*)",
      "Bash(aws dynamodb list-*:*)",
      "Bash(aws dynamodb scan:*)",
      "Bash(aws ec2 describe-*:*)",
      "Bash(aws ecr describe-*:*)",
      "Bash(aws ecr list-*:*)",
      "Bash(aws ecs describe-*:*)",
      "Bash(aws ecs list-*:*)",
      "Bash(aws elbv2 describe-*:*)",
      "Bash(aws events describe-*:*)",
      "Bash(aws events list-*:*)",
      "Bash(aws iam get-*:*)",
      "Bash(aws iam list-*:*)",
      "Bash(aws lambda get-*:*)",
      "Bash(aws lambda list-*:*)",
      "Bash(aws logs describe-*:*)",
      "Bash(aws logs filter-*:*)",
      "Bash(aws logs get-*:*)",
      "Bash(aws rds describe-*:*)",
      "Bash(aws route53 get-*:*)",
      "Bash(aws route53 list-*:*)",
      "Bash(aws s3 ls:*)",
      "Bash(aws s3api get-*:*)",
      "Bash(aws s3api head-*:*)",
      "Bash(aws s3api list-*:*)",
      "Bash(aws scheduler get-*:*)",
      "Bash(aws scheduler list-*:*)",
      "Bash(aws secretsmanager describe-*:*)",
      "Bash(aws secretsmanager get-*:*)",
      "Bash(aws secretsmanager list-*:*)",
      "Bash(aws sns get-*:*)",
      "Bash(aws sns list-*:*)",
      "Bash(aws sqs get-*:*)",
      "Bash(aws sqs list-*:*)",
      "Bash(aws sqs receive-*:*)",
      "Bash(aws ssm describe-*:*)",
      "Bash(aws ssm get-*:*)",
      "Bash(aws ssm list-*:*)",
      "Bash(aws sts get-caller-identity:*)",
      "Bash(aws timestream-influxdb get-*:*)",
      "Bash(aws timestream-influxdb list-*:*)",
      "Glob",
      "Grep",
      "LS",
      "Read",
      "WebFetch(domain:doc.rust-lang.org)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:fluxcd.io)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "mcp__context7__query-docs",
      "mcp__context7__resolve-library-id",
      "Bash(~/.claude/hooks/loop-arm.sh:*)"
    ],
    "deny": [
      "Read(~/.zshrc.local)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "( [ -n \"${HERDR_PANE_ID:-}\" ] && herdr pane report-agent \"$HERDR_PANE_ID\" --source claude-hooks --agent claude --state working ) >/dev/null 2>&1; true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "( [ -n \"${HERDR_PANE_ID:-}\" ] && herdr pane report-agent \"$HERDR_PANE_ID\" --source claude-hooks --agent claude --state working ) >/dev/null 2>&1; true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "( [ -n \"${HERDR_PANE_ID:-}\" ] && herdr pane report-agent \"$HERDR_PANE_ID\" --source claude-hooks --agent claude --state working ) >/dev/null 2>&1; true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "( [ -n \"${HERDR_PANE_ID:-}\" ] && herdr pane report-agent \"$HERDR_PANE_ID\" --source claude-hooks --agent claude --state blocked ) >/dev/null 2>&1; true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "( [ -n \"${HERDR_PANE_ID:-}\" ] && herdr pane report-agent \"$HERDR_PANE_ID\" --source claude-hooks --agent claude --state idle ) >/dev/null 2>&1; true"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "変更が検証されずに終わろうとしていないかを判定する。順に見る。(1) **先に次の 3 つを見る。どれか 1 つでも当たれば、以降の条件を一切読まずに {\"ok\": true} を返して終わる。** (a) 入力の stop_hook_active が true。(b) 入力の background_tasks に完了していない項目がある（結果待ちであり、ターンを閉じることがその待ち方。会話が未完了に見えるのは正常）。(c) 同じ根拠の hook feedback が既に会話に現れ、それに対する応答がなされている。(2) このセッションで Write / Edit / NotebookEdit が成功していなければ {\"ok\": true}。(3) 成功している場合、その変更を動かしたコマンド（テスト・ビルド・実行・lint）の出力が会話にあれば {\"ok\": true}。「書いた」「PASS するはず」という記述は証拠に数えない。(4) 出力が無くても、次のいずれかが会話にあれば {\"ok\": true}。(a) 検証を試みて実行できなかった事実（権限拒否・依存不足・環境エラー）。(b) 変更が文書・規約・プロンプトで実行対象を持たず、静的に確かめられる性質（構文の妥当性・参照の解決・意図した記述の有無）を実際にコマンドで確かめた出力がある。(5) それ以外は {\"ok\": false, \"reason\": \"<変更したファイル>を動かして確かめていない。検証コマンドを実行し、できないなら理由を述べて終われ\"}。ユーザーが要求したスコープの一部を黙って落としている場合も (5) と同様に扱う。ただしユーザーの判断を待っている項目は「落とした」に数えない。"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/loop-gate.sh\"",
            "timeout": 150
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "( [ -n \"${HERDR_PANE_ID:-}\" ] && herdr pane report-agent \"$HERDR_PANE_ID\" --source claude-hooks --agent claude --state blocked ) >/dev/null 2>&1; true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "( [ -n \"${HERDR_PANE_ID:-}\" ] && herdr pane release-agent \"$HERDR_PANE_ID\" --source claude-hooks --agent claude ) >/dev/null 2>&1; true"
          }
        ]
      }
    ]
  },
  "language": "Japanese",
  "effortLevel": "high",
  "remoteControlAtStartup": true,
  "voiceEnabled": true,
  "agentPushNotifEnabled": true,
  "enabledPlugins": {
    "slack@claude-plugins-official": true
  },
  "statusLine": {
    "type": "command",
    "command": "starship statusline claude-code"
  },
  "theme": "dark-ansi"
}
