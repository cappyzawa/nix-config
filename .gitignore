# Include CLAUDE.md (overrides global gitignore)
!CLAUDE.md
!AGENTS.md
!.claude/
!.codex/
.claude/*.local.*

# Ignore all skills, whitelist only repo-managed ones
# (~/.claude -> config/claude/ symlink causes plugin-installed skills to appear here)
config/claude/skills/*
!config/claude/skills/chore/
!config/claude/skills/codex/
!config/claude/skills/commander/
!config/claude/skills/empirical-prompt-tuning/
!config/claude/skills/issue
!config/claude/skills/japanese-tech-writing
!config/claude/skills/ponchi
!config/claude/skills/pull-request
!config/claude/skills/verify
!config/claude/skills/worktree/

# Codex system/plugin-managed skills are linked into ~/.codex at activation;
# only repository-managed Codex configuration belongs here.
config/codex/skills/*
!config/codex/skills/issue
!config/codex/skills/japanese-tech-writing
!config/codex/skills/ponchi
!config/codex/skills/pull-request
!config/codex/skills/verify
